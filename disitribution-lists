Import-Csv "C:\temp\dl2.csv" | Foreach { 
 New-DistributionGroup -Name $_.name -PrimarySmtpAddress $_.email
}

Import-Csv "C:\temp\dl-members.csv" | Foreach { 
 Add-DistributionGroupMember -Identity $_.email -Member $_.member
}

Import-Csv "C:\temp\group_aliases.csv" | Foreach { 
     Set-DistributionGroup -Identity $_.email -EmailAddresses @{Add=$_.alias}
}

Set-DistributionGroup -Identity $_.email -RequireSenderAuthenticationEnabled $false
