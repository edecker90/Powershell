# GOOD
$SiteURL = "https://domain-my.sharepoint.com/personal/user_name_domain_com"
Connect-PnPOnline -Url $SiteURL -Interactive -ClientID xxx
$folderPath = "/personal/user_name_domain_com/Documents/"
$items = Get-PnPListItem -List "Documents" -PageSize 2000
$Files = $items | Where-Object { ( $_.FieldValues.FileDirRef -like "$folderPath*" ) -and ( $_.FileSystemObjectType -eq "File" ) }

ForEach ($File in $Files)
{
    $HasUniquePermissions = Get-PnPProperty -ClientObject $File -Property HasUniqueRoleAssignments
    If($HasUniquePermissions)
    {
        $File.ResetRoleInheritance()
        $File.update()
        Invoke-PnPQuery
        Write-Host "Reset Unique Permissions on File $($File.FieldValues["FileRef"])" -ForegroundColor Green
    }
}

-------------------------------------------

$TargetUserEmail = "user@domain.com"
$ListName = "Documents" # Default library name for OneDrive files
$ListItems = Get-PnPListItem -List $ListName -PageSize 500
$UniquePermissionCount = 0
foreach ($Item in $ListItems) {
    $HasUniquePerms = Get-PnPProperty -ClientObject $Item -Property "HasUniqueRoleAssignments"
    if ($HasUniquePerms) {
        $RoleAssignments = Get-PnPListItemPermission -List $ListName -Identity $Item.Id
        foreach ($Role in $RoleAssignments) {
            if ($Role.Principal.Email -eq $TargetUserEmail -or $Role.Principal.LoginName -like "*$TargetUserEmail*") {
                $UniquePermissionCount++
            }
        }
    }
}
Write-Host "Total unique permission items for $TargetUserEmail $UniquePermissionCount" -ForegroundColor Green


